    alt: "Fake arrest scam screen variant 2",
    caption: "Mock fake arrest",
  },
  {
    img: "/case-studies/cyberboxx/learn-fake-arrest-interactive.png",
    alt: "Fake arrest scam interactive screen",
    caption: "Mock fake arrest interaction",
  },
  {
    img: "/case-studies/cyberboxx/learn-story.png",
    alt: "Learn story screen",
    caption: "Comic-styled-stories",
  },
  {
