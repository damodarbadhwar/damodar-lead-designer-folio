---
/**
 * Case study — Cyberboxx.
 * First-fold content from Case-study-Cyberboxx-desktop-01.pdf mapped onto
 * the existing layout, spacing, color, and typography conventions.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import FadeIn from "../../components/FadeIn.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TextBlock from "../../components/TextBlock.astro";
import MetaData from "../../components/MetaData.astro";
import NumberedItem from "../../components/NumberedItem.astro";

// — Page meta —
const summary = [
  { label: "ROLE", value: "Lead designer" },
  { label: "TIMELINE", value: "Apr 26 – Jun 26" },
  { label: "PLATFORM", value: "Web, Android" },
];

// — Fraud stat highlights —
const fraudStats = [
  {
    label: "Lost to online fraud",
    value: "22,495 Cr",
    note: "Lost to online fraud across India in 2025.",
  },
  {
    label: "Cybercrime cases reported",
    value: "28.15 Lakh",
    note: "Cybercrime cases reported in 2025.",
  },
];

// — Problem breakdown (01 / 02 from PDF) —
const problemPoints = [
  {
    title: "Lack of awareness",
    body: "Scammers use clever tactics and exploit emotions like fear, greed, and lust to trick people, making it difficult to tell what's real and what's a scam.",
  },
  {
    title: "Lack of guidance",
    body: "Once scammed, victims often don't know what steps to take, how to respond, or where to seek help.",
  },
];

// — 4 User persona cards —
const userPersonas = [
  {
    name: "Rajesh Sharma, 62",
    role: "Sr. Citizen",
    img: "/case-studies/cyberboxx/persona-rajesh.jpg",
    goal: "Use digital services safely and independently.",
    challenge: "Trusts authority figures and struggles with fraud identification.",
    opportunity: "Step-by-step guidance, reassurance, human support.",
  },
  {
    name: "Arjun Mehta, 29",
    role: "Urban worker",
    img: "/case-studies/cyberboxx/persona-arjun.jpg",
    goal: "Stay protected without investing significant effort.",
    challenge: "Aware of cyber risks but lacks visibility and actionable guidance.",
    opportunity: "Risk monitoring, quick actions, personalized recommendations.",
  },
  {
    name: "Sunita Devi, 36",
    role: "Migrant worker",
    img: "/case-studies/cyberboxx/persona-sunita.jpg",
    goal: "Protect her family's finances.",
    challenge: "Cannot distinguish scams from genuine opportunities.",
    opportunity: "Simple language, regional content, clear warnings.",
  },
  {
    name: "Sandeep Verma, 36",
    role: "Tier-3 worker",
    img: "/case-studies/cyberboxx/persona-sandeep.jpg",
    goal: "Avoid costly mistakes online",
    challenge: "Cannot confidently judge whether something is risky",
    opportunity: "Trust indicators, simplified security advice, contextual education.",
  },
];
---

<BaseLayout
  title="Cyberboxx: Designing Online Safety for Indian Users — Damodar Badhwar"
  description="Adapting and redesigning Cyberboxx for Indian users across Web and Android."
>
  <!-- Top container: 24px above nav, then nav, then 56px gap before title -->
  <div class="mx-auto w-full max-w-[1400px] px-4 pt-6 md:px-[60px]">
    <Nav />
  </div>

  <article>
    <div class="mx-auto w-full max-w-[1280px]">

    <!-- ─────────── Title ─────────── -->
    <FadeIn>
      <header class="px-4 pt-14 pb-14 md:px-[60px]">
        <h1
          class="block w-full font-serif font-medium text-ink-3 leading-[1.2] text-[32px] tracking-[-0.64px] md:text-[56px] md:tracking-[-1.12px]"
        >
          Cyberboxx: Designing Online Safety for Indian Users
        </h1>
      </header>
    </FadeIn>

    <!-- ─────────── Summary metadata ─────────── -->
    <FadeIn delay={80}>
      <section class="px-4 pb-14 md:px-[60px]">
        <div class="flex flex-wrap gap-x-8 gap-y-5 md:gap-x-16">
          {summary.map((item) => (
            <MetaData label={item.label} value={item.value} />
          ))}
        </div>
      </section>
    </FadeIn>

    <!-- ─────────── Hero image ─────────── -->
    <FadeIn delay={120}>
      <section class="px-4 pb-14 md:px-[60px]">
        <div class="overflow-hidden rounded-2xl bg-grey-200 aspect-[1160/434]">
          <img
            src="/case-studies/cyberboxx/hero.jpg"
            alt="Cyberboxx: Designing Online Safety for Indian Users"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      </section>
    </FadeIn>

    <!-- ─────────── Overview ─────────── -->
    <FadeIn>
      <section class="px-4 pb-[72px] md:px-[60px]">
        <div class="flex flex-col gap-3 md:flex-row md:gap-8 md:items-start">
          <div class="md:w-[280px] md:shrink-0">
            <TextBlock variant="section-title">Overview</TextBlock>
          </div>
          <div class="md:flex-1">
            <TextBlock variant="body-lg">
              Cyberboxx is a cybersecurity platform built to protect digital identities. The product is already live in the Canadian market. This project focused on redesigning that existing product for Indian users.
            </TextBlock>
          </div>
        </div>
      </section>
    </FadeIn>

    <!-- ─────────── The Reality of Online Safety in India ─────────── -->
    <FadeIn>
      <section class="px-4 pb-[72px] md:px-[60px]">
        <div class="flex flex-col gap-6 md:flex-row md:gap-8 md:items-start">
          <div class="md:w-[280px] md:shrink-0">
            <TextBlock variant="section-title">The Reality of Online Safety in India</TextBlock>
          </div>
          <div class="md:flex-1 flex flex-col gap-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
              {fraudStats.map((stat) => (
                <div class="rounded-xl bg-surface-2 p-6 flex flex-col gap-2">
                  <TextBlock variant="caption">{stat.label}</TextBlock>
                  <TextBlock variant="stat-value">{stat.value}</TextBlock>
                  <TextBlock variant="body">{stat.note}</TextBlock>
                </div>
              ))}
            </div>
            <div class="flex flex-col gap-4">
              <TextBlock variant="body-lg">
                The problem is two-fold:
              </TextBlock>
              {problemPoints.map((point, i) => (
                <NumberedItem n={i + 1} title={point.title}>
                  {point.body}
                </NumberedItem>
              ))}
            </div>
          </div>
        </div>
      </section>
    </FadeIn>

    <!-- ─────────── Client's brief ─────────── -->
    <FadeIn>
      <section class="px-4 pb-[72px] md:px-[60px]">
        <div class="flex flex-col gap-3 md:flex-row md:gap-8 md:items-start">
          <div class="md:w-[280px] md:shrink-0">
            <TextBlock variant="section-title">Client's brief</TextBlock>
          </div>
          <div class="md:flex-1">
            <TextBlock variant="body">
              Cyberboxx is an established cybersecurity product in Canadian market and was looking to expand its reach to India. The goal was to adapt and redesign the existing product to make it more suitable and accessible for Indian users, considering their different needs, backgrounds, and levels of digital literacy.
            </TextBlock>
          </div>
        </div>
      </section>
    </FadeIn>

    <!-- ─────────── Understanding the Users (4 Persona Cards) ─────────── -->
    <FadeIn>
      <section class="px-4 pb-10 md:px-[60px]">
        <TextBlock variant="section-title" as="h3">Understanding the Users</TextBlock>
      </section>
    </FadeIn>

    <FadeIn>
      <section class="px-4 pb-[72px] md:px-[60px]">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {userPersonas.map((persona) => (
            <div class="rounded-2xl border border-divider overflow-hidden bg-white flex flex-col">
              <div class="p-6 flex flex-col sm:flex-row items-center sm:items-start gap-4 border-b border-divider">
                <div class="rounded-xl overflow-hidden bg-grey-200 size-20 shrink-0">
                  <img
                    src={persona.img}
                    alt={persona.name}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-col gap-1 text-center sm:text-left">
                  <TextBlock variant="caption">{persona.role}</TextBlock>
                  <h4 class="text-[20px] font-medium leading-[1.4] text-ink-2">{persona.name}</h4>
                </div>
              </div>
              <div class="bg-surface-2 p-6 flex-1 flex flex-col gap-4">
                <div>
                  <TextBlock variant="caption">GOAL</TextBlock>
                  <ul class="list-disc pl-5 mt-2 flex flex-col gap-2 text-[14px] leading-[1.5] text-ink-2">
                    <li>{persona.goal}</li>
                  </ul>
                </div>
                <div>
                  <TextBlock variant="caption">CHALLENGE</TextBlock>
                  <ul class="list-disc pl-5 mt-2 flex flex-col gap-2 text-[14px] leading-[1.5] text-ink-2">
                    <li>{persona.challenge}</li>
                  </ul>
                </div>
                <div>
                  <TextBlock variant="caption">DESIGN OPPORTUNITY</TextBlock>
                  <ul class="list-disc pl-5 mt-2 flex flex-col gap-2 text-[14px] leading-[1.5] text-ink-2">
                    <li>{persona.opportunity}</li>
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </FadeIn>

    <!-- ─────────── Core user need ─────────── -->
    <FadeIn>
      <section class="px-4 pb-[72px] md:px-[60px]">
        <div class="rounded-2xl bg-surface-2 p-6 flex flex-col gap-2">
          <TextBlock variant="caption">CORE USER NEED</TextBlock>
          <TextBlock variant="body-lg">
            A fraud safety companion: something that speaks their language, tells them if they're safe, and guides them when they're not.
          </TextBlock>
        </div>
      </section>
    </FadeIn>

    </div>
  </article>

  <SiteFooter variant="case-study" />
</BaseLayout>
