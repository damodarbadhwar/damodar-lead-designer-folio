  "Grouped educational content into dedicated Learn section for easier discovery.",
  "Critical actions are surfaced first, so users know exactly what to do next.",
];

// — Learn experience individual screens —
const learnScreens = [
  {
    img: "/case-studies/cyberboxx/learn-otp-scam.png",
    alt: "OTP scam screen",
    caption: "OTP scam",
  },  
  {
    img: "/case-studies/cyberboxx/learn-fake-arrest.png",
    alt: "Fake arrest scam screen",
